# === Нужно для бота (python -m bot.main) ===
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=
# Username бота без @ (используется в ссылках сайта)
BOT_USERNAME=Almau_mes_bot
# Сколько жалоб от разных людей до автоматической блокировки
REPORTS_TO_BAN=3

# === Нужно для API (python -m bot.api_server) — бота не требует ===
# Порт веб-API. На Railway подставляется автоматически, локально можно не задавать
PORT=8080
# Разрешённый источник для CORS веб-API (домен сайта). "*" — разрешить всем, подходит для защиты
CORS_ORIGIN=*
# Секрет для просмотра заявок без бота: GET /api/leads?token=<ADMIN_TOKEN>. Пусто — эндпоинт выключен
ADMIN_TOKEN=
# Telegram id организаторов клуба Summit Seekers через запятую: им приходят записи, SOS и тревоги,
# у них работает /club. Админы из ADMIN_IDS получают то же самое.
CLUB_ADMIN_IDS=
# Вход в «Анонимный чат» на сайте — без пароля, код на почту через Brevo (brevo.com, бесплатно
# до 300 писем/день). API-ключ: Brevo → SMTP & API → API Keys. Если не задано, код виден только
# в логах сервера (удобно для локальной разработки, но письма реально не уходят).
BREVO_API_KEY=
# Отправитель должен быть подтверждён в Brevo: Senders, Domains & Dedicated IPs → Senders → Add a sender
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Almau Messenger
