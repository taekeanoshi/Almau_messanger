# === Нужно для бота (python -m bot.main) ===
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=
# Username бота без @ (используется в ссылках сайта)
BOT_USERNAME=almau_messenger_bot
# Сколько жалоб от разных людей до автоматической блокировки
REPORTS_TO_BAN=3

# === Нужно для API (python -m bot.api_server) — бота не требует ===
# Порт веб-API. На Railway подставляется автоматически, локально можно не задавать
PORT=8080
# Разрешённый источник для CORS веб-API (домен сайта). "*" — разрешить всем, подходит для защиты
CORS_ORIGIN=*
# Секрет для просмотра заявок без бота: GET /api/leads?token=<ADMIN_TOKEN>. Пусто — эндпоинт выключен
ADMIN_TOKEN=
