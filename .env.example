# Переменные сервера Pople (python -m bot.api_server)
# Сколько жалоб от разных людей до автоматической блокировки
REPORTS_TO_BAN=3

# Порт веб-API. На Railway подставляется автоматически, локально можно не задавать
PORT=8080
# Разрешённый источник для CORS веб-API — домен сайта, например https://almau-messenger.vercel.app.
# "*" разрешает запросы с любых сайтов: годится только для локальной разработки
CORS_ORIGIN=*
# Длинный случайный секрет для серверных админ-команд (назначить первого администратора — см. README).
# Передаётся в заголовке X-Admin-Token. Пусто — эти команды выключены
ADMIN_TOKEN=
# Где лежит база. На Railway укажите путь на подключённом Volume, иначе данные стираются при каждом деплое
# DB_PATH=/data/almau.db
# Коды подтверждения почты и сброса пароля на сайте уходят через Brevo (brevo.com, бесплатно
# до 300 писем/день). API-ключ: Brevo → SMTP & API → API Keys. Если не задано, код виден только
# в логах сервера (удобно для локальной разработки, но письма реально не уходят).
BREVO_API_KEY=
# Отправитель должен быть подтверждён в Brevo: Senders, Domains & Dedicated IPs → Senders → Add a sender
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pople

# Демо-студенты для вкладки «Люди» (казахские и русские имена) — добавляются при старте API.
# Число аккаунтов; 0 — не создавать. Войти под ними нельзя, в публичную статистику они не входят, а админ удаляет их кнопкой в «Админке».
SEED_DEMO_PEOPLE=150

# Адрес сайта для ссылок в письмах клубов (подтверждение, напоминания)
SITE_URL=https://almau-messenger.vercel.app
# Демо-вход для показа: 0 — выключить; свой пароль для обоих демо-аккаунтов
DEMO_LOGIN=1
DEMO_LOGIN_PASSWORD=
